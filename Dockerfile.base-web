# ============================================================
# langfuse-web 基础镜像（第一阶段：本地构建，需能上外网）
# 版本以你自己代码为准：node24 / turbo 2.10.5 / pnpm 11.10.0 /
#                        migrate v4.19.1 / prisma 6.19.3
#
# 目标镜像地址（推到你已建好的 base-image-repo）:
#   artifact.nc.rdcloud.4c.hq.cmcc:80/base-image-repo/langfuse-base:web
#
# 本地构建 + 推送命令（在本文件所在目录执行）:
#   docker build --platform linux/amd64 \
#     -t artifact.nc.rdcloud.4c.hq.cmcc:80/base-image-repo/langfuse-base:web \
#     -f Dockerfile.base-web .
#   docker push artifact.nc.rdcloud.4c.hq.cmcc:80/base-image-repo/langfuse-base:web
# （推送前需先 docker login，见随附的操作说明）
# ============================================================

FROM node:24-alpine

# [对应原 web/Dockerfile 的 alpine 阶段] 系统安全更新
RUN apk update && apk upgrade --no-cache libcrypto3 libssl3 libc6-compat busybox ssl_client zlib

# [对应原 web/Dockerfile 的 build-base 阶段] turbo + pnpm
RUN npm install turbo@2.10.5 --global
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN corepack prepare pnpm@11.10.0 --activate

# [对应原 web/Dockerfile 的 migrate-builder 阶段]
# 原版用独立的 golang:1.26 镜像编译 migrate；这里学同事 base-web 的做法，
# 改用 alpine 自带 go 包临时编译，编完即删，避免额外维护一个 golang 基础镜像。
# 编译参数（clickhouse tag、v4.19.1）与你原 Dockerfile 保持一致。
RUN apk add --no-cache --virtual .go-build-deps go git && \
    GOBIN=/usr/bin GOFLAGS=-trimpath CGO_ENABLED=0 \
    go install -tags 'clickhouse' -ldflags='-s -w' \
        github.com/golang-migrate/migrate/v4/cmd/migrate@v4.19.1 && \
    chmod +x /usr/bin/migrate && \
    apk del .go-build-deps && \
    rm -rf /root/go /root/.cache/go-build

# [对应原 web/Dockerfile 的 runner 阶段] dumb-init + tzdata
RUN apk add --no-cache dumb-init tzdata

# [对应原 web/Dockerfile runner 阶段的 prisma CLI]
# 原版：npm install -g prisma@6.19.3
# prisma 引擎走【自动下载】：本地能上外网，安装时会自动拉取 alpine(musl) 版引擎。
# —— 若本地构建到这一步卡在 prisma 引擎下载（超时/失败），说明自动下载不通，
#    需回退为同事那种“手动预置引擎”的方式（提前下好引擎二进制 COPY 进来）。
#    回退方法我们再单独处理，先按自动下载试。
RUN npm install -g --no-package-lock --no-save prisma@6.19.3

# 基础镜像标记
RUN printf 'BASE=langfuse-web\nNODE=24-alpine\nPNPM=11.10.0\nTURBO=2.10.5\nMIGRATE=v4.19.1\nPRISMA=6.19.3\nBUILD_TIMESTAMP=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /base-image-info
